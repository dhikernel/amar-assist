# -----------------------------------------------------------------------------
# Variáveis do AMBIENTE DOCKER — lidas pelo docker compose.
#
#   cp .env.example .env
#
# IMPORTANTE: este arquivo não é o .env da aplicação (esse fica em backend/.env).
# Os nomes aqui são propositalmente diferentes dos usados pelo Laravel
# (APP_HOST_PORT em vez de APP_PORT, MYSQL_* em vez de DB_*). O Compose resolve
# o .env a partir do diretório corrente: se os nomes fossem iguais, rodar
# `docker compose` de dentro de backend/ leria o .env do Laravel e publicaria as
# portas erradas — silenciosamente. Nomes distintos tornam a colisão impossível.
# -----------------------------------------------------------------------------

# UID/GID do host, para que os arquivos criados dentro do container (migrations,
# storage, cache) não fiquem como root. Descubra os seus com: id -u && id -g
UID=1000
GID=1000

# Porta em que a aplicação responde no host -> http://localhost:8000
APP_HOST_PORT=8000

# --- MySQL --------------------------------------------------------------------
# Estes valores precisam bater com DB_DATABASE / DB_USERNAME / DB_PASSWORD
# em backend/.env, que é como a aplicação se conecta pela rede interna.
MYSQL_DATABASE=amar_assist
MYSQL_USER=amar
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root
# 3307 no host para não conflitar com um MySQL já instalado na máquina.
# Dentro da rede Docker a porta continua sendo 3306.
MYSQL_HOST_PORT=3307

# --- Redis --------------------------------------------------------------------
# REDIS_AUTH precisa bater com REDIS_PASSWORD em backend/.env.
REDIS_AUTH=redissecret
# 6381 no host para não conflitar com um Redis já em execução.
REDIS_HOST_PORT=6381

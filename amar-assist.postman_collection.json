        {
          "name": "Cadastrar Contrato - Ciclo 31",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonResponse = pm.response.json();",
                  "if (jsonResponse.id) {",
                  "    pm.globals.set(\"contrato_id\", jsonResponse.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"

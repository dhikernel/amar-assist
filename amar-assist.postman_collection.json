              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonResponse = pm.response.json();",
                  "if (jsonResponse.data && jsonResponse.data.length > 0) {",
                  "    pm.globals.set(\"cliente_id\", jsonResponse.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/clientes?filter[situacao]=ativo&per_page=1",
              "host": [

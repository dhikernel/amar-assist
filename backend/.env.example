APP_NAME="Amar Assist Cobrancas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://amar-assist.site

# Regra de negócio (c) depende da data corrente: o fuso é explícito e não
# pode ficar em UTC, sob pena de virar o dia e calcular juros a mais/a menos.
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Host "mysql" = nome do serviço no docker-compose (rede interna, porta 3306).
# Fora do container, o banco responde em localhost:3307.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=amar_assist
DB_USERNAME=amar
DB_PASSWORD=secret

# Banco isolado usado pela suíte PHPUnit (criado no boot do container MySQL)
DB_TEST_DATABASE=amar_assist_test

BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

# Diferencial do teste: cache e filas no Redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=redissecret
REDIS_PORT=6379
REDIS_CLIENT=phpredis

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@amarassist.local"
MAIL_FROM_NAME="${APP_NAME}"

# Autenticação (Laravel Sanctum, tokens Bearer)
# Minutos de validade do token emitido no login; null = não expira.
SANCTUM_TOKEN_EXPIRATION=480

# Origem do SPA Vue liberada no CORS
FRONTEND_URL=http://localhost:5173

# Paginação padrão das listagens
AMOUNT_PAGINATE_DEFAULT=15

# Regras de cobrança
COBRANCA_JUROS_DIARIO=1.0
COBRANCA_MULTA_PERCENTUAL=2.0

# Documentação da API (l5-swagger) — acessível em /api/documentation
L5_SWAGGER_CONST_HOST=https://amar-assist.site/api
L5_SWAGGER_GENERATE_ALWAYS=true

# Prefixos de chave no Redis (evita o prefixo duplicado do padrão Laravel 9)
REDIS_PREFIX=amar_assist:
CACHE_PREFIX=cache
